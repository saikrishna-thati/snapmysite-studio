# SnapMySite Studio Production Environment Configuration
# Add these variables in Vercel Project Settings -> Environment Variables

# Groq LLM API Keys (comma-separated list for automatic key-cycling and rate-limit failover)
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3,gsk_key4,gsk_key5,gsk_key6

# TypeSafe JEV Semantic Decision & Verification Keys (comma-separated for failover)
JEV_API_KEYS=apikey_jev_key1,apikey_jev_key2

# Node Environment
NODE_ENV=production
PORT=3000
