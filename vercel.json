{
  "framework": "vite",
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/studio/index.html"
    },
    {
      "source": "/studio",
      "destination": "/studio/index.html"
    },
    {
      "source": "/cue.css",
      "destination": "/studio/cue.css"
    },
    {
      "source": "/studio.css",
      "destination": "/studio/studio.css"
    },
    {
      "source": "/experience.css",
      "destination": "/studio/experience.css"
    },
    {
      "source": "/favicon.svg",
      "destination": "/studio/favicon.svg"
    },
    {
      "source": "/js/(.*)",
      "destination": "/studio/js/$1"
    },
    {
      "source": "/audio/(.*)",
      "destination": "/studio/audio/$1"
    },
    {
      "source": "/studio/(.*)",
      "destination": "/studio/$1"
    }
  ]
}
